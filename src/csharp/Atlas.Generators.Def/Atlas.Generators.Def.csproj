<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>Atlas.Generators.Def</RootNamespace>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Defs.Parser\Atlas.Defs.Parser.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

  <!-- Propagate Atlas.Defs.Parser.dll as an analyzer payload to downstream
       projects that reference Atlas.Generators.Def with OutputItemType=Analyzer.
       Without this, csc can load DefGenerator but FileNotFoundException fires
       at IIncrementalGenerator.Initialize time when the generator hits any
       Atlas.Defs.Parser type. -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);_IncludeParserInTargetPath</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="_IncludeParserInTargetPath" Returns="@(TargetPathWithTargetPlatformMoniker)">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker
          Include="$(MSBuildThisFileDirectory)$(OutputPath)Atlas.Defs.Parser.dll"
          IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>

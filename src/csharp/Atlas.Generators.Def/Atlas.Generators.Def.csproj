<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>Atlas.Generators.Def</RootNamespace>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atlas.Defs.Parser\Atlas.Defs.Parser.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

  <!-- Without this, csc loads DefGenerator but FileNotFoundException fires at
       IIncrementalGenerator.Initialize when it touches Atlas.Defs.Parser. -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);_IncludeParserInTargetPath</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="_IncludeParserInTargetPath" Returns="@(TargetPathWithTargetPlatformMoniker)">
    <ItemGroup>
      <!-- Path.Combine returns the 2nd arg unchanged if absolute (CMake csharp
           build), or roots it to the project dir if relative (dotnet build). -->
      <TargetPathWithTargetPlatformMoniker
          Include="$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$([MSBuild]::EnsureTrailingSlash($(OutputPath)))Atlas.Defs.Parser.dll'))"
          IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.1 so Unity (Mono / IL2CPP) consumes directly; net10.0 build skips the
         polyfill block so consumers don't clash with the BCL ModuleInitializerAttribute. -->
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Atlas.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- One dependency only: Atlas.Shared. CoreCLR hosting types must not leak in here. -->
    <ProjectReference Include="..\Atlas.Shared\Atlas.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atlas.Client.Tests" />
  </ItemGroup>
</Project>

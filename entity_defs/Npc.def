<entity name="Npc" has_base="false">

  <properties>
    <property name="hp"      type="int32" scope="all_clients" reliable="true" />
    <property name="npcType" type="int32" scope="all_clients" />
    <!-- AI state lives on the cell only; carried in Serialize/Deserialize so
         the script-side AI loop resumes mid-wander after a cross-cellapp
         offload instead of reseeding to defaults. -->
    <property name="aiTarget"        type="vector3" scope="cell_private" />
    <property name="aiRetargetAccum" type="float"   scope="cell_private" />
    <property name="aiFireInterval"  type="float"   scope="cell_private" />
  </properties>

  <client_methods>
    <method name="ShowDamage">
      <arg name="amount"     type="int32" />
      <arg name="attackerId" type="uint32" />
    </method>
    <method name="OnProjectileFired">
      <arg name="shotId"   type="uint32" />
      <arg name="origin"   type="vector3" />
      <arg name="velocity" type="vector3" />
    </method>
    <method name="OnProjectileEnded">
      <arg name="shotId"      type="uint32" />
      <arg name="endPos"      type="vector3" />
      <arg name="hitTargetId" type="uint32" />
    </method>
  </client_methods>

</entity>

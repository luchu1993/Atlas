<entity name="Avatar">

  <properties>
    <property name="hp"       type="int32"   scope="all_clients"           persistent="true"  reliable="true" />
    <property name="gold"     type="int32"   scope="own_client"            persistent="true"  reliable="true" />
    <property name="aiState"  type="int32"   scope="cell_public"                              reliable="true" />
    <property name="modelId"  type="int32"   scope="other_clients"                            reliable="true" />
    <property name="mana"     type="int32"   scope="cell_public_and_own" />
    <property name="secret"   type="string"  scope="base_and_client"       persistent="true"  reliable="true" />
    <property name="level"    type="int32"   scope="own_client"            persistent="true"  reliable="true" />
  </properties>

  <client_methods>
    <method name="ShowDamage">
      <arg name="amount"     type="int32" />
      <arg name="attackerId" type="uint32" />
    </method>
    <method name="OnDied">
      <arg name="attackerId" type="uint32" />
    </method>
    <method name="OnRespawned">
      <arg name="pos" type="vector3" />
    </method>
    <method name="OnProjectileFired">
      <arg name="shotId"   type="uint32" />
      <arg name="origin"   type="vector3" />
      <arg name="velocity" type="vector3" />
    </method>
    <method name="OnProjectileEnded">
      <arg name="shotId"      type="uint32" />
      <arg name="endPos"      type="vector3" />
      <arg name="hitTargetId" type="uint32" />
    </method>
    <method name="OnChat">
      <arg name="senderId" type="uint32" />
      <arg name="text"     type="string" />
    </method>
    <method name="OnSessionInfo">
      <arg name="label" type="string" />
    </method>
  </client_methods>

  <cell_methods>
    <method name="ReportPos" exposed="own_client">
      <arg name="pos" type="vector3" />
      <arg name="dir" type="vector3" />
    </method>
    <method name="LaunchProjectile" exposed="own_client">
      <arg name="forward" type="vector3" />
    </method>
    <method name="Say" exposed="own_client">
      <arg name="text" type="string" />
    </method>
    <!-- Cross-cellapp damage entry: simulator on attacker's cell calls
         NativeApi.SendCellRpc when target Avatar is Ghost on this cell. -->
    <method name="TakeDamage">
      <arg name="amount"     type="int32" />
      <arg name="attackerId" type="uint32" />
    </method>
  </cell_methods>

  <components>
    <component name="equipment" type="EquipmentComponent" scope="all_clients" />
  </components>

</entity>

<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/LoginScreen.uss" />
    <ui:VisualElement name="overlay" class="overlay">
        <ui:VisualElement class="brand">
            <ui:Label text="ATLAS" class="brand-mark" />
            <ui:Label text="MVP // OPERATIONS" class="brand-sub" />
        </ui:VisualElement>

        <ui:VisualElement class="panel">
            <ui:Label text="OPERATOR LOGIN" class="title" />
            <ui:VisualElement class="title-rule" />
            <ui:Label text="ESTABLISH CONNECTION TO ENTER BATTLE" class="subtitle" />

            <ui:VisualElement class="field-group">
                <ui:Label text="SERVER" class="field-label" />
                <ui:VisualElement class="row">
                    <ui:TextField name="host-field" class="input host" />
                    <ui:TextField name="port-field" class="input port" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="field-group">
                <ui:Label text="CALL SIGN" class="field-label" />
                <ui:TextField name="username-field" class="input" />
            </ui:VisualElement>

            <ui:VisualElement class="field-group">
                <ui:Label text="ACCESS KEY" class="field-label" />
                <ui:TextField name="password-field" password="true" class="input" />
            </ui:VisualElement>

            <ui:Button name="login-button" text="DEPLOY" class="login-btn" />
            <ui:Label name="status-label" text="" class="status" />
        </ui:VisualElement>

        <ui:VisualElement class="footer">
            <ui:Label text="// ATLAS ENGINE — MVP CLIENT" class="footer-text" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

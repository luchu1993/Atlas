.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(255, 45, 120);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px;
}

.brand {
    flex-direction: column;
    align-items: center;
    margin-bottom: 36px;
}

.brand-mark {
    color: rgb(255, 230, 0);
    font-size: 88px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 4px;
}

.brand-sub {
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin-top: 6px;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 2px;
}

.panel {
    width: 460px;
    flex-direction: column;
    align-items: stretch;
    padding: 28px;
    background-color: rgb(255, 255, 255);
    border-width: 5px;
    border-color: rgb(0, 0, 0);
    border-radius: 28px;
}

.title {
    font-size: 30px;
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.title-rule {
    width: 96px;
    height: 5px;
    background-color: rgb(160, 240, 30);
    margin-bottom: 14px;
    align-self: center;
    border-radius: 3px;
}

.subtitle {
    color: rgb(90, 90, 90);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 22px;
    -unity-text-align: middle-center;
}

.field-group {
    margin-bottom: 14px;
}

.field-label {
    color: rgb(40, 40, 40);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.row {
    flex-direction: row;
}

.input {
    height: 40px;
    color: rgb(20, 20, 20);
    --unity-cursor-color: rgb(255, 45, 120);
    --unity-selection-color: rgba(255, 45, 120, 0.3);
}

.input > TextInput,
.input > .unity-base-text-field__input {
    flex-grow: 1;
    background-color: rgb(248, 248, 248);
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    border-radius: 20px;
    color: rgb(20, 20, 20);
    padding: 0 16px;
    font-size: 14px;
    -unity-font-style: bold;
}

.input:focus > TextInput,
.input:focus > .unity-base-text-field__input {
    border-color: rgb(255, 45, 120);
    background-color: rgb(255, 255, 255);
}

.input TextElement,
.input .unity-text-element {
    color: rgb(20, 20, 20);
}

.host {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    min-width: 0;
    margin-right: 10px;
    width: auto;
}

.port {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100px;
    min-width: 100px;
    max-width: 100px;
}

.login-btn {
    height: 54px;
    margin-top: 18px;
    background-color: rgb(160, 240, 30);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    font-size: 18px;
    letter-spacing: 6px;
    border-width: 4px;
    border-color: rgb(0, 0, 0);
    border-radius: 28px;
}

.login-btn:hover {
    background-color: rgb(190, 255, 60);
}

.login-btn:active {
    background-color: rgb(130, 210, 10);
}

.login-btn:disabled {
    background-color: rgb(220, 220, 220);
    color: rgb(120, 120, 120);
    border-color: rgb(80, 80, 80);
}

.status {
    -unity-text-align: middle-center;
    margin-top: 14px;
    white-space: normal;
    color: rgb(40, 40, 40);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    min-height: 20px;
}

.status.error {
    color: rgb(220, 20, 20);
}

.footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    align-items: center;
}

.footer-text {
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1.5px;
}

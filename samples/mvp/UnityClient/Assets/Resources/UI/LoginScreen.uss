.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 9, 11);
    flex-direction: column;
    padding-top: 70px;
    padding-left: 80px;
    padding-right: 80px;
    padding-bottom: 60px;
}

.brand {
    flex-direction: column;
    margin-bottom: 56px;
}

.brand-mark {
    color: rgb(245, 167, 35);
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 12px;
}

.brand-sub {
    color: rgb(120, 120, 120);
    font-size: 11px;
    letter-spacing: 6px;
    margin-top: 2px;
    margin-left: 4px;
}

.panel {
    width: 420px;
    flex-direction: column;
}

.title {
    font-size: 28px;
    color: rgb(245, 245, 245);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 6px;
}

.title-rule {
    width: 48px;
    height: 3px;
    background-color: rgb(245, 167, 35);
    margin-bottom: 10px;
}

.subtitle {
    color: rgb(110, 110, 110);
    font-size: 10px;
    letter-spacing: 3px;
    margin-bottom: 32px;
}

.field-group {
    margin-bottom: 20px;
}

.field-label {
    color: rgb(170, 170, 170);
    font-size: 10px;
    letter-spacing: 4px;
    margin-bottom: 8px;
}

.row {
    flex-direction: row;
}

.input {
    height: 32px;
    color: rgb(245, 245, 245);
    --unity-cursor-color: rgb(245, 167, 35);
    --unity-selection-color: rgba(245, 167, 35, 0.35);
}

.input > TextInput,
.input > .unity-base-text-field__input {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.03);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.18);
    border-radius: 0;
    color: rgb(245, 245, 245);
    padding: 0 4px;
    font-size: 14px;
}

.input:focus > TextInput,
.input:focus > .unity-base-text-field__input {
    border-bottom-color: rgb(245, 167, 35);
    background-color: rgba(245, 167, 35, 0.05);
}

.input TextElement,
.input .unity-text-element {
    color: rgb(245, 245, 245);
}

.host {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    min-width: 0;
    margin-right: 12px;
    width: auto;
}

.port {
    flex-grow: 0;
    flex-shrink: 0;
    width: 110px;
    min-width: 110px;
    max-width: 110px;
}

.login-btn {
    height: 46px;
    margin-top: 24px;
    background-color: rgb(245, 167, 35);
    color: rgb(8, 9, 11);
    -unity-font-style: bold;
    font-size: 15px;
    letter-spacing: 10px;
    border-width: 0;
    border-radius: 0;
}

.login-btn:hover {
    background-color: rgb(255, 195, 80);
}

.login-btn:active {
    background-color: rgb(220, 145, 20);
}

.login-btn:disabled {
    background-color: rgb(32, 32, 32);
    color: rgb(90, 90, 90);
}

.status {
    -unity-text-align: middle-left;
    margin-top: 18px;
    white-space: normal;
    color: rgb(170, 170, 170);
    font-size: 11px;
    letter-spacing: 2px;
    min-height: 20px;
}

.status.error {
    color: rgb(255, 90, 90);
}

.footer {
    position: absolute;
    left: 80px;
    bottom: 30px;
}

.footer-text {
    color: rgb(70, 70, 70);
    font-size: 10px;
    letter-spacing: 4px;
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 8, 10);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.panel {
    width: 340px;
    flex-direction: column;
    align-items: stretch;
}

.brand-mark {
    color: rgb(245, 245, 245);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 16px;
    -unity-text-align: middle-center;
    margin-bottom: 56px;
}

.field-group {
    margin-bottom: 20px;
}

.field-label {
    color: rgb(130, 130, 130);
    font-size: 10px;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.row {
    flex-direction: row;
}

.input {
    height: 42px;
    min-height: 42px;
    color: rgb(245, 245, 245);
    --unity-cursor-color: rgb(245, 245, 245);
    --unity-selection-color: rgba(255, 255, 255, 0.2);
}

.input > TextInput,
.input > .unity-base-text-field__input {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.22);
    border-radius: 0;
    color: rgb(245, 245, 245);
    padding: 0 2px;
    font-size: 14px;
}

.input:focus > TextInput,
.input:focus > .unity-base-text-field__input {
    border-bottom-color: rgb(245, 245, 245);
}

.input TextElement,
.input .unity-text-element {
    color: rgb(245, 245, 245);
}

.host {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    min-width: 0;
    margin-right: 16px;
    width: auto;
}

.port {
    flex-grow: 0;
    flex-shrink: 0;
    width: 90px;
    min-width: 90px;
    max-width: 90px;
}

.login-btn {
    height: 42px;
    margin-top: 28px;
    background-color: rgb(245, 245, 245);
    color: rgb(8, 8, 10);
    -unity-font-style: bold;
    font-size: 12px;
    letter-spacing: 6px;
    border-width: 0;
    border-radius: 0;
}

.login-btn:hover {
    background-color: rgb(220, 220, 220);
}

.login-btn:active {
    background-color: rgb(190, 190, 190);
}

.login-btn:disabled {
    background-color: rgb(50, 50, 52);
    color: rgb(110, 110, 110);
}

.status {
    -unity-text-align: middle-center;
    margin-top: 16px;
    white-space: normal;
    color: rgb(140, 140, 140);
    font-size: 11px;
    letter-spacing: 1px;
    min-height: 20px;
}

.status.error {
    color: rgb(255, 100, 100);
}

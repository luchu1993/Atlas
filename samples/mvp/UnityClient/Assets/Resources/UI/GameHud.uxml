<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/GameHud.uss" />
    <ui:VisualElement name="hud-root" picking-mode="Ignore" class="hud-root">

        <ui:VisualElement name="hp-card" class="card hp-card">
            <ui:Label name="hp-name" text="Avatar" class="hp-name" />
            <ui:VisualElement class="hp-bar-track">
                <ui:VisualElement name="hp-bar-fill" class="hp-bar-fill" />
            </ui:VisualElement>
            <ui:Label name="hp-text" text="HP --/--" class="hp-text" />
        </ui:VisualElement>

        <ui:VisualElement name="stats-card" class="card stats-card">
            <ui:VisualElement class="stat-row">
                <ui:Label text="FPS" class="stat-key" />
                <ui:Label name="fps-value" text="--" class="stat-value" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="Ping" class="stat-key" />
                <ui:Label name="ping-value" text="-- ms" class="stat-value" />
            </ui:VisualElement>
            <ui:Toggle name="aoi-toggle" label="Show AoI" class="aoi-toggle" />
            <ui:Button name="logout-button" text="Return to Login" class="logout-btn" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>

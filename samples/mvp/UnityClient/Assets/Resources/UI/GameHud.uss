.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hp-card {
    position: absolute;
    left: 28px;
    top: 28px;
    width: 280px;
}

.hp-name {
    color: rgb(245, 245, 245);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.hp-bar-track {
    height: 5px;
    background-color: rgba(255, 255, 255, 0.12);
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(245, 245, 245);
    border-radius: 0;
}

.hp-bar-fill.warn {
    background-color: rgb(245, 167, 35);
}

.hp-bar-fill.danger {
    background-color: rgb(230, 70, 70);
}

.hp-bar-fill.dead {
    background-color: rgb(80, 80, 80);
}

.hp-text {
    margin-top: 8px;
    color: rgb(180, 180, 180);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
}

.stats-card {
    position: absolute;
    right: 28px;
    top: 28px;
    width: 200px;
    align-items: stretch;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.stat-key {
    color: rgb(150, 150, 150);
    font-size: 10px;
    letter-spacing: 3px;
}

.stat-value {
    color: rgb(245, 245, 245);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.aoi-toggle {
    margin-top: 14px;
    flex-direction: row;
    align-items: center;
}

.aoi-checkbox {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.55);
    border-radius: 0;
}

.aoi-checkbox.checked {
    background-color: rgb(245, 167, 35);
    border-color: rgb(245, 167, 35);
}

.aoi-label {
    color: rgb(200, 200, 200);
    font-size: 10px;
    letter-spacing: 3px;
}

.logout-btn {
    margin-top: 18px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(245, 167, 35);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    border-width: 1px;
    border-color: rgb(245, 167, 35);
    border-radius: 0;
}

.logout-btn:hover {
    background-color: rgb(245, 167, 35);
    color: rgb(8, 9, 11);
}

.logout-btn:active {
    background-color: rgb(220, 145, 20);
    border-color: rgb(220, 145, 20);
    color: rgb(8, 9, 11);
}

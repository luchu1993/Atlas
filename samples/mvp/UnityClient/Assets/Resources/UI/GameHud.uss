.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.stats-card {
    position: absolute;
    left: 24px;
    top: 18px;
    flex-direction: column;
    align-items: flex-start;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.stat-key {
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    letter-spacing: 2px;
    margin-right: 10px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 1px;
}

.stat-value {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 1px;
}

.logout-btn {
    position: absolute;
    right: 24px;
    top: 18px;
    height: 28px;
    padding: 0 16px;
    background-color: rgba(0, 0, 0, 0.35);
    color: rgb(245, 245, 245);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    border-radius: 0;
}

.logout-btn:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.85);
}

.logout-btn:active {
    background-color: rgba(255, 255, 255, 0.32);
}

.hp-anchor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 36px;
    flex-direction: row;
    justify-content: center;
}

.hp-card {
    width: 340px;
    flex-direction: column;
    align-items: stretch;
}

.hp-name {
    color: rgba(255, 255, 255, 0.85);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 1px;
}

.hp-bar-track {
    height: 10px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.45);
    border-radius: 0;
    overflow: hidden;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(255, 255, 255);
    border-radius: 0;
}

.hp-bar-fill.warn {
    background-color: rgb(255, 200, 50);
}

.hp-bar-fill.danger {
    background-color: rgb(255, 80, 80);
}

.hp-bar-fill.dead {
    background-color: rgb(120, 120, 120);
}

.hp-text {
    margin-top: 5px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    -unity-text-outline-width: 1px;
}

.debug-panel {
    position: absolute;
    right: 24px;
    bottom: 28px;
    padding: 14px 18px 14px 16px;
    background-color: rgba(0, 0, 0, 0.7);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 0;
    display: none;
}

.debug-title {
    color: rgb(245, 167, 35);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.aoi-toggle {
    flex-direction: row;
    align-items: center;
}

.aoi-checkbox {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    margin-right: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.7);
    border-radius: 0;
}

.aoi-checkbox.checked {
    background-color: rgb(245, 167, 35);
    border-color: rgb(245, 167, 35);
}

.aoi-label {
    color: rgba(255, 255, 255, 0.9);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

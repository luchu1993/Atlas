.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hp-card {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 290px;
    padding: 14px 18px 16px 18px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    border-radius: 22px;
}

.hp-name {
    color: rgb(20, 20, 20);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.hp-bar-track {
    height: 14px;
    background-color: rgb(35, 35, 35);
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    border-radius: 9px;
    overflow: hidden;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(160, 240, 30);
    border-radius: 7px;
}

.hp-bar-fill.warn {
    background-color: rgb(255, 215, 0);
}

.hp-bar-fill.danger {
    background-color: rgb(255, 45, 120);
}

.hp-bar-fill.dead {
    background-color: rgb(110, 110, 110);
}

.hp-text {
    margin-top: 8px;
    color: rgb(40, 40, 40);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-right;
}

.stats-card {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 210px;
    padding: 14px 18px 16px 18px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    border-radius: 22px;
    align-items: stretch;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.stat-key {
    color: rgb(60, 60, 60);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.stat-value {
    color: rgb(20, 20, 20);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.aoi-toggle {
    margin-top: 10px;
    flex-direction: row;
    align-items: center;
}

.aoi-checkbox {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin-right: 8px;
    background-color: rgb(248, 248, 248);
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    border-radius: 5px;
}

.aoi-checkbox.checked {
    background-color: rgb(255, 215, 0);
    border-color: rgb(0, 0, 0);
}

.aoi-label {
    color: rgb(40, 40, 40);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.logout-btn {
    margin-top: 14px;
    height: 34px;
    background-color: rgb(255, 45, 120);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    border-radius: 18px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
}

.logout-btn:hover {
    background-color: rgb(255, 95, 155);
}

.logout-btn:active {
    background-color: rgb(220, 20, 95);
}

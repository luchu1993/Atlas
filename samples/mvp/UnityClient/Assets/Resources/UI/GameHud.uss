.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hp-card {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 280px;
    padding: 12px 16px 14px 16px;
    background-color: rgba(8, 9, 11, 0.7);
    border-top-width: 2px;
    border-top-color: rgb(245, 167, 35);
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
}

.hp-name {
    color: rgb(245, 245, 245);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.hp-bar-track {
    height: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 0;
    border-radius: 0;
    overflow: hidden;
}

.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(245, 245, 245);
    border-radius: 0;
}

.hp-bar-fill.warn {
    background-color: rgb(245, 167, 35);
}

.hp-bar-fill.danger {
    background-color: rgb(230, 70, 70);
}

.hp-bar-fill.dead {
    background-color: rgb(110, 110, 110);
}

.hp-text {
    margin-top: 8px;
    color: rgb(210, 210, 210);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
}

.stats-card {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 200px;
    padding: 12px 16px 14px 16px;
    background-color: rgba(8, 9, 11, 0.7);
    border-top-width: 2px;
    border-top-color: rgb(245, 167, 35);
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    align-items: stretch;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.stat-key {
    color: rgb(170, 170, 170);
    font-size: 10px;
    letter-spacing: 3px;
}

.stat-value {
    color: rgb(245, 245, 245);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.aoi-toggle {
    margin-top: 12px;
    flex-direction: row;
    align-items: center;
}

.aoi-checkbox {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.6);
    border-radius: 0;
}

.aoi-checkbox.checked {
    background-color: rgb(245, 167, 35);
    border-color: rgb(245, 167, 35);
}

.aoi-label {
    color: rgb(220, 220, 220);
    font-size: 10px;
    letter-spacing: 3px;
}

.logout-btn {
    margin-top: 16px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(245, 167, 35);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    border-width: 1px;
    border-color: rgb(245, 167, 35);
    border-radius: 0;
}

.logout-btn:hover {
    background-color: rgb(245, 167, 35);
    color: rgb(8, 9, 11);
}

.logout-btn:active {
    background-color: rgb(220, 145, 20);
    border-color: rgb(220, 145, 20);
    color: rgb(8, 9, 11);
}
